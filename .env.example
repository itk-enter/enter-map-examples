# Copy to .env (or .env.local) and fill in. Both are git-ignored and must stay
# out of the repo.
#
# Nothing here is needed to run the demo: the data snapshot is in the
# repository, and the only page that needs a key is "find nærmeste" on
# parkering.html.

# Enter instance the data snapshot is pulled from, by bin/fetch-data.sh.
ENTER_BASE_URL=https://enter.srvitkstgweb02.itkdev.dk

# Basic auth for that instance, as user:password. Ask ITK Dev for it.
ENTER_BASIC_AUTH=

# Entity types to snapshot with bin/fetch-data.sh, comma separated.
ENTER_TYPES=handicapparkering,hundeskov

# Enter source ids to snapshot with bin/fetch-sources.sh, comma separated. The
# instance lists them in /sources.json.
ENTER_SOURCES=test:osm-bench,test:osm-public-toilet,test:mtm_spatialmaps-toilet-city,test:mtm_spatialmaps-toilet-other,test:merged-public-toilets

# Key for Septima's routing service, used by the `route` control on
# parkering.html. Comes with the Septima Widget agreement; Septima also publish
# a demo key in their own example configurations. `task route:key` writes it
# into public/config/key.json, which is git-ignored — the browser sends the key,
# so it is readable by anyone using the page and cannot be kept secret, only out
# of the repository.
SEPTIMA_ROUTE_APIKEY=
